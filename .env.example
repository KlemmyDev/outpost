# Outpost server settings. install.sh copies this to .env (chmod 600) on the
# first install and asks for the time zone and port. Things people change day
# to day live in the app's Settings instead.

# Web port on this machine.
PORT=3000

# Time zone, e.g. Australia/Sydney, Australia/Perth.
TZ=Australia/Brisbane

# Force features on or off for everyone, and lock them in Settings.
# Comma-separated: a name switches it on, -name switches it off.
#   OUTPOST_FEATURES=messages,-power
OUTPOST_FEATURES=

# Where updates come from. Only change this if you run your own fork.
OUTPOST_REPO=KlemmyDev/outpost

# Optional: a GitHub token only raises the update check's rate limit.
GITHUB_TOKEN=
