{
  "name": "outpost",
  "version": "2026.11.27",
  "private": true,
  "description": "Off-grid Unified Tools for Preparedness, Orientation, Survival & Telecomms. A self-hosted offline library, mesh comms and home server HQ.",
  "type": "module",
  "outpost": {
    "release": "alpha"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "css-select": "^7.0.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "fast-xml-parser": "^5.12.1",
    "htmlparser2": "^12.0.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.2"
  }
}
